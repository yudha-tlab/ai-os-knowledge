@startuml
!include style.iuml
title 1-2 · Lead masuk lewat webhook → Queue → di-claim Sales
participant "Website form\n(Sistem Klien)" as W
participant "CRM\nInbound API" as API
participant "Penugasan\n(aturan tenant)" as R
database "Lead + Queue" as DB
