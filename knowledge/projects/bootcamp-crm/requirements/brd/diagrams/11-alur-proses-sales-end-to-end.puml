@startuml
title Alur Proses Sales End-to-End — dari Lead Masuk sampai Laporan

skinparam shadowing false
skinparam defaultFontSize 12

start
partition "1 · Inbound — lead masuk" {
  :Lead masuk ke CRM;
  note right
    Tiga jalur masuk:
    - input manual lewat form CRM
    - import file (CSV/Excel)
    - kiriman sistem lain lewat webhook inbound
  end note
  :Lead tercatat beserta sumber dan waktu masuk;
}
partition "2 · Penugasan & qualification" {
  :Lead punya Owner (Manager assign, Sales claim dari Queue,\natau Owner otomatis);
  :Sales melakukan kontak awal;
  if (Lolos qualification?) then (ya)
    :Status lead menjadi In Progress;
  else (tidak)
    :Status lead menjadi Lost (+alasan);
    stop
  endif
}
partition "3 · Convert" {
  :Lead di-convert;
  note right
    Satu convert menghasilkan
    tiga entitas sekaligus:
    Contact + Account + Opportunity,
    atau memakai Account/Contact
    yang sudah ada.
    Pelanggan B2C boleh berdiri
    sebagai Contact tanpa Account.
  end note
}
partition "4 · Pipeline — pergerakan peluang" {
  :Opportunity masuk stage Qualification;
  :Stage berpindah saat kriteria keluar terpenuhi;
  note right
    Enam stage berjalan:
    Qualification -> Needs Analysis
    -> Demo -> Proposal
    -> Negotiation -> Decision Pending.
    Stage dan kriteria keluar diatur
    tenant. Stage boleh mundur
    dengan alasan wajib.
  end note
}
partition "5 · Penutupan" {
  if (Keputusan pembeli?) then (won)
    :Opportunity ditutup Closed-Won (+alasan);
  else (lost)
    :Opportunity ditutup Closed-Lost (+alasan);
  endif
}
partition "6 · Pelaporan" {
  :Laporan revenue (dari closed-won);
  :Laporan pipeline & forecast;
  :Laporan performa sales (quota attainment);
}
:Proses sales selesai — hasilnya terukur;

note right
  Activity (call/meeting/email/task/note) berjalan di samping seluruh
  fase dan menjadi dasar next step. Asistensi AI adalah lapisan bantuan
  yang berjalan di samping alur ini, bukan bagian dari alur inti.
end note
stop
@enduml
