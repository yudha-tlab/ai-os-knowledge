@startuml
title Diagram 1 — Konteks Sistem: CRM Multi-Tenant TLab

skinparam shadowing false
skinparam componentStyle rectangle
left to right direction

actor "Sales Rep" as SR
actor "Sales Manager" as SM
actor "Agent Support" as AS
actor "Support Lead" as SL
actor "Tenant Admin" as TA
actor "Pelanggan\n(B2B / B2C)" as CUST
actor "Karyawan Tenant" as EMP

rectangle "CRM Multi-Tenant TLab" as CRMBOUND {
  component "CORE CRM\n(stabil — tidak dimodifikasi per klien)" as CORE
}

cloud "Sistem Klien\n(di luar CRM)" as EXT
component "Service Eksternal\n(buatan klien)" as SVC

SR --> CORE
SM --> CORE
AS --> CORE
SL --> CORE
TA --> CORE
EMP --> CORE : permintaan / tiket internal
CUST --> CORE : keluhan / tiket eksternal

CORE ..> EXT : event outbound\n(webhook, async)
EXT ..> CORE : data masuk\n(webhook inbound)
EXT --> SVC : meneruskan event
note right of SVC
  Kustomisasi klien dibangun DI SINI,
  bukan dengan mengubah core (DEC-012)
end note

note bottom of CORE
  Dikelola per tenant dengan isolasi data
  antar tenant (DEC-029)
end note
@enduml
