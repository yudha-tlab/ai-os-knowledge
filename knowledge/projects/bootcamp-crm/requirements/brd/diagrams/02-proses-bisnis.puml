@startuml
title Diagram 2 — Proses Bisnis Sales End-to-End (P01–P08)

skinparam shadowing false
skinparam defaultFontSize 12

start
partition "P01–P02 · Input: Lead & Pelanggan" {
  :Penangkapan lead
  (form CRM atau webhook inbound);
  :Distribusi lead ke sales;
  :Kualifikasi lead;
  if (Lolos kualifikasi?) then (ya)
    :Konversi menjadi
    Kontak + Akun + Peluang;
  else (tidak)
    :Lead ditandai hilang;
    stop
  endif
}
partition "P03 · Perencanaan: Kuota" {
  :Penetapan kuota sales
  per periode BULANAN;
}
partition "P04 · Pelaksanaan: Pipeline" {
  :Pengelolaan peluang
  (nilai, stage, tanggal tutup);
  :Pergerakan stage peluang;
  :Penutupan peluang
  (closed-won / closed-lost + alasan);
}
partition "P07 · Evaluasi: Performa Sales" {
  :Perhitungan quota attainment
  (closed-won dibanding kuota bulanan);
  :Penandaan status performa
  (ambang batas configurable, default 80%);
}
partition "P08 · Output: Pelaporan Sales" {
  :Laporan revenue (closed-won);
  :Laporan pipeline dan forecast;
  :Laporan performa sales;
}
:Core platform CRM selesai
(backend menyelesaikan seluruh fitur mandatory);
note right
  P05 (Aktivitas) = nice to have, di luar lingkup MVP.
  P10–P11 (Tenancy, Webhook) = proses pendukung
  yang berjalan lintas semua fase di atas.
end note
stop
@enduml
