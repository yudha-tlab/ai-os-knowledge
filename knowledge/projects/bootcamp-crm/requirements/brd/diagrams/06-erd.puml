@startuml
title Diagram 5 — Entity Relationship Diagram (konseptual, fokus sales)

skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontSize 11
hide circle

entity "Tenant" as TEN {
  * id
  --
  nama
  konfigurasi
  **status_langganan (roadmap)**
}

entity "Pengguna" as USR {
  * id
  --
  tenant_id
  role / permission
}

entity "Akun\n(organisasi — B2B)" as AKN {
  * id
  --
  tenant_id
  nama
}

entity "Kontak\n(individu)" as KON {
  * id
  --
  tenant_id
  akun_id (opsional — B2C)
}

entity "Lead" as LEAD {
  * id
  --
  tenant_id
  status
  pemilik (sales)
}

entity "Peluang" as PEL {
  * id
  --
  tenant_id
  nilai deal
  stage
  tanggal tutup
}

entity "Kuota Sales" as KUO {
  * id
  --
  tenant_id
  sales_id
  periode BULANAN
  nilai target
}

entity "Skor Performa Sales" as SKOR {
  * id
  --
  tenant_id
  sales_id
  quota attainment
  status performa
}

entity "Ambang Performa" as AMB {
  * id
  --
  tenant_id
  nilai ambang
  (default 80%)
}

entity "Laporan Revenue" as LRV {
  * id
  --
  tenant_id
  periode
  nilai closed-won
}

entity "Laporan Pipeline" as LPL {
  * id
  --
  tenant_id
  pipeline & forecast
}

entity "Laporan Performa" as LPF {
  * id
  --
  tenant_id
  attainment per sales
}

entity "Aktivitas\n(nice to have — M5)" as AKT {
  * id
  --
  tenant_id
  jenis (call/meeting/task/note)
}

entity "Webhook Subscription" as SUB {
  * id
  --
  tenant_id
  event yang di-subscribe
}

entity "Webhook Target" as WTG {
  * id
  --
  subscription_id
  endpoint
}

entity "Hasil Asistensi AI\n(M10)" as AIO {
  * id
  --
  tenant_id
  record terkait (lead/peluang)
  jenis use case (draf/ringkasan)
  isi keluaran
}

entity "Delivery Log" as LOG {
  * id
  --
  target_id
  status kirim
  percobaan / retry
}

package "FASE ROADMAP (M9) — SaaS Platform Administration" #LightGray {
  entity "Paket Pricing (Plan)" as PLAN {
    * id
    --
    nama paket
    struktur harga
  }
  entity "Kuota & Batas Paket" as QUOTA {
    * id
    --
    plan_id
    maks seat
    maks record
    kuota webhook
  }
  entity "Langganan (Subscription)" as SUBS {
    * id
    --
    tenant_id
    plan_id
    periode mulai/berakhir
    status
  }
  entity "Pembayaran" as PAY {
    * id
    --
    tenant_id
    subscription_id
    bukti
    status konfirmasi
  }
  entity "Status Penegakan" as ENF {
    * id
    --
    tenant_id
    level (peringatan/
    suspend/read-only)
  }
  entity "Jejak Audit Platform" as AUD {
    * id
    --
    actor (Platform Owner)
    aksi, waktu
  }
}

TEN ||--o{ USR
TEN ||--o{ AKN
TEN ||--o{ KON
TEN ||--o{ LEAD
TEN ||--o{ PEL
TEN ||--o{ KUO
TEN ||--o{ SKOR
TEN ||--o{ AMB
TEN ||--o{ LRV
TEN ||--o{ LPL
TEN ||--o{ LPF
TEN ||--o{ AKT
TEN ||--o{ SUB

TEN ||--o{ SUBS : "roadmap"
SUBS }o--|| PLAN : "roadmap"
PLAN ||--o{ QUOTA : "roadmap"
TEN ||--o{ PAY : "roadmap"
SUBS ||--o{ PAY : "roadmap"
TEN ||--o{ ENF : "roadmap"
SUBS ||..o{ ENF : "penegakan batas"
AUD }o--|| TEN : "roadmap"

TEN ||--o{ AIO : "hasil AI (M10)"
AIO }o--o| LEAD : draf & insight
AIO }o--o| PEL : ringkasan peluang

AKN |o--o{ KON : "B2B: kontak di bawah akun\nB2C: kontak tanpa akun"
LEAD ||..o{ KON : konversi
LEAD ||..o{ AKN : konversi
LEAD ||..o{ PEL : konversi
PEL }o--|| AKN
PEL }o--|| KON
KUO }o--|| USR : target per sales
SKOR }o--|| KUO : dihitung dari kuota
SKOR }o--|| AMB : memakai ambang
LRV }o--o{ PEL : agregasi closed-won
LPL }o--o{ PEL
LPF }o--o{ SKOR
AKT }o--o| PEL
AKT }o--o| LEAD

SUB ||--o{ WTG : fan-out
WTG ||--o{ LOG

note bottom of KON
  Kontak B2C boleh berdiri tanpa Akun.
end note

note bottom of AIO
  Titik simpan output AI — WAJIB dirancang
  sejak M1 agar use case AI prediktif (roadmap)
  tidak memerlukan migrasi data.
  Konteks AI dibatasi tenant.
end note

note bottom of TEN
  Entitas dalam package abu-abu = FASE ROADMAP,
  di luar MVP bootcamp. Yang WAJIB diperhitungkan
  sekarang: kolom status_langganan pada Tenant,
  agar tidak perlu rework saat M9 dikerjakan.
end note
@enduml
